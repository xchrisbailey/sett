#!/usr/bin/env bash
# Launch sett against a throwaway copy of fixture data, screenshot its window, quit.
#
#   scripts/screenshot [--root DIR] [--space personal|work] [--editor block|raw] [--open SLUG] [--data DIR] [--delay SECS] OUT.png
#
# --root builds and runs the checkout at DIR (another worktree) instead of this
# one; pass that worktree's CARGO_TARGET_DIR with it.
#
# --data defaults to scripts/fixtures/sett. The copy lives in a temp HOME, so the
# real ~/sett and settings are never touched. The app opens on the Space's Inbox
# Board, or with --open on the Item a Link to SLUG leads to, in the editor.
# For other screens, edit a copy of the fixtures.
# --delay (seconds, default 1) waits for the first frames to render.
# A tiling window manager can shrink the window well below the 1024x720 pt sett
# asks for; the script then warns, and Columns past the first may be cut off.
# Needs Screen Recording permission for the terminal (System Settings → Privacy &
# Security); without it the capture comes back blank.
# Agents: run it as its own Bash call starting with `scripts/screenshot`, full
# paths, no `X=...;` before it. The sandbox exception in .claude/settings.json
# only matches that form; inside the sandbox the capture fails with
# "could not create image from window". Subagents can't capture at all; see
# docs/agents/worktrees.md.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
space=personal
editor=block
data="$root/scripts/fixtures/sett"
out=""
delay=1
open=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --space) space="$2"; shift 2 ;;
        --editor) editor="$2"; shift 2 ;;
        --data) data="$2"; shift 2 ;;
        --open) open=(--open "$2"); shift 2 ;;
        --delay) delay="$2"; shift 2 ;;
        --root) root="$(cd "$2" && pwd)"; data="$root/scripts/fixtures/sett"; shift 2 ;;
        -h|--help) sed -n '2,23p' "$0"; exit 0 ;;
        *) out="$1"; shift ;;
    esac
done
[[ -n "$out" ]] || { echo "usage: scripts/screenshot [--space S] [--editor E] [--open SLUG] [--root DIR] [--data DIR] [--delay SECS] OUT.png" >&2; exit 2; }

target="${CARGO_TARGET_DIR:-$root/target}"
(cd "$root" && cargo build -q -p sett)

home="$(mktemp -d)"
trap 'kill "$pid" 2>/dev/null || true; rm -rf "$home"' EXIT
cp -R "$data" "$home/sett"
mkdir -p "$home/Library/Application Support/sett"
cat > "$home/Library/Application Support/sett/settings.toml" <<EOF
data_root = "$home/sett"
editor_mode = "$editor"
last_space = "$space"
EOF

HOME="$home" "$target/debug/sett" ${open[@]+"${open[@]}"} >"$home/sett.log" 2>&1 &
pid=$!

id=""
for _ in $(seq 1 60); do
    kill -0 "$pid" 2>/dev/null || { echo "sett exited early:" >&2; cat "$home/sett.log" >&2; exit 1; }
    found="$(swift "$here/window-id.swift" "$pid" 2>/dev/null || true)"
    read -r id width height <<<"$found" || true
    [[ -n "${id:-}" ]] && break
    sleep 0.5
done
[[ -n "${id:-}" ]] || { echo "no sett window appeared within 30s" >&2; exit 1; }
if (( width < 960 || height < 640 )); then
    echo "screenshot: the window is ${width}x${height} pt, not 1024x720 (a tiling window manager?); Columns past the first may be cut off" >&2
fi

sleep "$delay" # let the first frames render
screencapture -x -o -l "$id" "$out"
echo "$out"
