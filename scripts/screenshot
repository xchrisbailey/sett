#!/usr/bin/env bash
# Launch sett against a throwaway copy of fixture data, screenshot its window, quit.
#
#   scripts/screenshot [--space personal|work] [--editor block|raw] [--data DIR] OUT.png
#
# --data defaults to scripts/fixtures/sett. The copy lives in a temp HOME, so the
# real ~/sett and settings are never touched. The app opens on the Space's Inbox
# Board; to capture another screen, edit a copy of the fixtures.
# SETT_SHOT_DELAY (seconds, default 1) waits for the first frames to render.
# Needs Screen Recording permission for the terminal (System Settings → Privacy &
# Security); without it the capture comes back blank.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
space=personal
editor=block
data="$root/scripts/fixtures/sett"
out=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --space) space="$2"; shift 2 ;;
        --editor) editor="$2"; shift 2 ;;
        --data) data="$2"; shift 2 ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) out="$1"; shift ;;
    esac
done
[[ -n "$out" ]] || { echo "usage: scripts/screenshot [--space S] [--editor E] [--data DIR] OUT.png" >&2; exit 2; }

target="${CARGO_TARGET_DIR:-$root/target}"
(cd "$root" && cargo build -q -p sett)

home="$(mktemp -d)"
trap 'kill "$pid" 2>/dev/null || true; rm -rf "$home"' EXIT
cp -R "$data" "$home/sett"
mkdir -p "$home/Library/Application Support/sett"
cat > "$home/Library/Application Support/sett/settings.toml" <<EOF
data_root = "$home/sett"
editor_mode = "$editor"
last_space = "$space"
EOF

HOME="$home" "$target/debug/sett" >"$home/sett.log" 2>&1 &
pid=$!

id=""
for _ in $(seq 1 60); do
    kill -0 "$pid" 2>/dev/null || { echo "sett exited early:" >&2; cat "$home/sett.log" >&2; exit 1; }
    id="$(swift "$root/scripts/window-id.swift" "$pid" 2>/dev/null || true)"
    [[ -n "$id" ]] && break
    sleep 0.5
done
[[ -n "$id" ]] || { echo "no sett window appeared within 30s" >&2; exit 1; }

sleep "${SETT_SHOT_DELAY:-1}" # let the first frames render
screencapture -x -o -l "$id" "$out"
echo "$out"
